    "InsertDef": {
      "additionalProperties": false,
      "description": "A sheet insert: one of the half-sheets a game slips inside a playbook.\n\n`gear`, `followers` and `arcana` are built into the engine (the Inventory sheet and the\ngeneric follower sheet); everything else a pack wants \u2014 a warband, a spellbook, an animal\ncompanion, the ghost you become \u2014 is declared here. An insert is a small playbook:\nsections and moves that live on the sheet once it is taken.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "playbook",
          "description": "Free-form grouping, e.g. 'playbook' or 'fate'.",
          "title": "Kind",
          "type": "string"
        },
        "blurb": {
          "default": "",
          "title": "Blurb",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Markdown shown at the top of the insert.",
          "title": "Description",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "moves": {
          "items": {
            "$ref": "#/$defs/Move"
          },
          "title": "Moves",
          "type": "array"
        },
        "starting_moves": {
          "$ref": "#/$defs/StartingMoves",
          "description": "Moves gained with the insert; the rest are picked."
        },
        "hold_names": {
          "items": {
            "type": "string"
          },
          "title": "Hold Names",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "InsertDef",
      "type": "object"
    },
