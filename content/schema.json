    "Tracks": {
      "additionalProperties": false,
      "description": "The boxes the book prints, each drawn as its own glyph.\n\nThe rulebook uses three: a square you tick to take a thing, a diamond for one box of carried\nload, and a circle for a use or an ammo status. `bulk` and `uses` are counts of boxes;\n`statuses` names them, and they are marked left to right (Book I, p94).",
      "properties": {
        "marks": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Squares: plain ticks, e.g. progress towards a requirement.",
          "title": "Marks"
        },
        "bulk": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Diamonds: boxes of carried load.",
          "title": "Bulk"
        },
        "uses": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Circles: charges, doses, hours.",
          "title": "Uses"
        },
        "statuses": {
          "description": "Named circles marked left to right, e.g. ['low ammo', 'all out'].",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Statuses",
          "type": "array"
        }
      },
      "title": "Tracks",
      "type": "object"
    },
